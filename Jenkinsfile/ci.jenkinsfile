pipeline {
    agent any

    environment {
        DOCKERHUB_USERNAME = "kannancloud"
        BUILD_TAG = "${BUILD_NUMBER}"
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Gitleaks Security Scan') {
            steps {
                sh '''
                    chmod +x automation/security/scan_gitleaks.sh
                    ./automation/security/scan_gitleaks.sh
                '''
            }
        }

        stage('Verify Tools') {
            steps {
                sh '''
                    git --version
                    docker --version
                    kubectl version --client
                    python3 --version
                '''
            }
        }

        stage('Verify Docker') {
            steps {
                sh 'docker ps'
            }
        }

        stage('Verify Kubernetes') {
            steps {
                sh '''
                    kubectl get nodes
                    kubectl get namespaces
                '''
            }
        }

        stage('SonarQube Analysis') {
            steps {
                script {
                    def scannerHome = tool 'SonarScanner'

                    withSonarQubeEnv('SonarQube') {
                        sh "${scannerHome}/bin/sonar-scanner"
                    }
                }
            }
        }

        stage('Quality Gate') {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Build Docker Images') {
            steps {
                sh '''
                    chmod +x automation/docker/build_images.sh
                    ./automation/docker/build_images.sh ${BUILD_NUMBER}
                '''
            }
        }

        stage('Trivy Security Scan') {
            steps {
                sh '''
                    chmod +x automation/security/scan_backend.sh
                    chmod +x automation/security/scan_frontend.sh

                    ./automation/security/scan_backend.sh
                    ./automation/security/scan_frontend.sh
                '''
            }
        }

        stage('Push Docker Images') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub-creds',
                        usernameVariable: 'DOCKER_USER',
                        passwordVariable: 'DOCKER_PASS'
                    )
                ]) {
                    sh '''
                        chmod +x automation/docker/push_images.sh
                        ./automation/docker/push_images.sh ${BUILD_NUMBER}
                    '''
                }
            }
        }

        stage('Update Kubernetes Manifests') {
            steps {
                sh '''
                    chmod +x automation/gitops/update_image_tags.sh
                    ./automation/gitops/update_image_tags.sh ${BUILD_NUMBER}
                '''
            }
        }

        stage('Commit Manifest Changes') {
            steps {
                sh '''
                    git config user.name "Jenkins"
                    git config user.email "jenkins@local"

                    git add kubernetes/

                    if git diff --cached --quiet; then
                        echo "No manifest changes to commit."
                    else
                        git commit -m "ci: update image tags to ${BUILD_NUMBER}"
                    fi
                '''
            }
        }

        stage('Push Manifest Changes') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'github-pat',
                        usernameVariable: 'GIT_USER',
                        passwordVariable: 'GIT_TOKEN'
                    )
                ]) {

                    sh '''
                        git push https://${GIT_USER}:${GIT_TOKEN}@github.com/Kannacse/HRMS-AWS.git HEAD:feature/gitops
                    '''
                }
            }
        }
    }

    post {
        success {
            archiveArtifacts artifacts: 'reports/**/*', fingerprint: true
            cleanWs()

            echo "====================================="
            echo "HRMS GitOps Pipeline Completed"
            echo "Images pushed to Docker Hub"
            echo "Git manifests updated"
            echo "Argo CD will sync automatically"
            echo "====================================="
        }

        failure {
            archiveArtifacts artifacts: 'reports/**/*', fingerprint: true
            cleanWs()

            echo "====================================="
            echo "HRMS GitOps Pipeline Failed"
            echo "====================================="
        }
    }
}
