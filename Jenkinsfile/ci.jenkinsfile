pipeline {
    agent any

    environment {
        COMPOSE_PROJECT_NAME = "hrms"
        KUBECONFIG = "/var/lib/jenkins/.kube/config"
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Gitleaks Security Scan') {
            steps {
                sh '''
                    chmod +x automation/security/scan_gitleaks.sh
                    ./automation/security/scan_gitleaks.sh
                '''
            }
        }

        stage('Verify Tools') {
            steps {
                sh '''
                    git --version
                    docker --version
                    kubectl version --client
                    python3 --version
                '''
            }
        }

        stage('Verify Docker') {
            steps {
                sh 'docker ps'
            }
        }

        stage('Verify Kubernetes') {
            steps {
                sh '''
                    kubectl get nodes
                    kubectl get namespaces
                '''
            }
        }

        stage('SonarQube Analysis') {
            steps {
                script {
                    def scannerHome = tool 'SonarScanner'

                    withSonarQubeEnv('SonarQube') {
                        sh """
                            ${scannerHome}/bin/sonar-scanner
                        """
                    }
                }
            }
        }

        stage('Quality Gate') {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Build Docker Images') {
            steps {
                sh '''
                    chmod +x automation/docker/build_images.sh
                    ./automation/docker/build_images.sh ${BUILD_NUMBER}
                '''
            }
        }

        stage('Trivy Security Scan') {
            steps {
                sh '''
                    chmod +x automation/security/scan_backend.sh
                    chmod +x automation/security/scan_frontend.sh

                    ./automation/security/scan_backend.sh
                    ./automation/security/scan_frontend.sh
                '''
            }
        }

        stage('Push Docker Images') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub-creds',
                        usernameVariable: 'DOCKER_USER',
                        passwordVariable: 'DOCKER_PASS'
                    )
                ]) {
                    sh '''
                        chmod +x automation/docker/push_images.sh
                        ./automation/docker/push_images.sh ${BUILD_NUMBER}
                    '''
                }
            }
        }

        stage('Import Images to K3s') {
            steps {
                sh '''
                    chmod +x automation/docker/import_images.sh
                    ./automation/docker/import_images.sh test
                '''
            }
        }

        stage('Deploy to K3s') {
            steps {
                sh '''
                    chmod +x automation/kubernetes/deploy_hrms.sh
                    ./automation/kubernetes/deploy_hrms.sh test
                '''
            }
        }

        stage('Verify Deployment') {
            steps {
                sh 'python3 automation/deploy/verify_deployment.py'
            }
        }
    }

    post {

        success {
            echo '✅ HRMS CI/CD Pipeline completed successfully.'
        }

        failure {
            echo '❌ HRMS CI/CD Pipeline failed.'
        }

        always {
            archiveArtifacts artifacts: 'reports/trivy/*.txt, reports/gitleaks/*.sarif', fingerprint: true
            cleanWs()
        }
    }
}
